# OMEGA DRAKON • SYSTEMS
# Exemplo de variáveis de ambiente para a API Layer
# Copiar para /home/alex/NV/.env (ou mesclar com o existente)
# Interface Viva: Nicky Virthy
# Arquiteto: Alex Projeti

# ----------------------------------------------------------
# Porta e bind oficiais da API Layer
# ----------------------------------------------------------
NV_API_HOST=0.0.0.0
NV_API_PORT=7001

# ----------------------------------------------------------
# Autenticação
# ----------------------------------------------------------
# Obrigatório em produção. Sem valor = modo aberto (dev).
NV_API_KEY=troque_esta_chave_por_uma_forte

# ----------------------------------------------------------
# CORS (produção)
# ----------------------------------------------------------
# Vazio          → nenhuma origem externa (mais seguro)
# *              → libera tudo (somente desenvolvimento)
# lista CSV      → origens permitidas
NV_CORS_ORIGINS=https://app.seudominio.com
NV_CORS_ALLOW_CREDENTIALS=false

# ----------------------------------------------------------
# Rate Limit
# ----------------------------------------------------------
NV_RATE_LIMIT_ENABLED=true
NV_RATE_LIMIT_REQUESTS=60
NV_RATE_LIMIT_WINDOW=60
